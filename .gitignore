# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
.env
.env.local


# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts


// CREATE TABLE public.bookings (
    id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    created_at TIMESTAMPTZ DEFAULT NOW(),

    -- Booking dates
    "startDate" TIMESTAMP,
    "endDate" TIMESTAMP,
    "numNights" SMALLINT,
    "numGuests" SMALLINT DEFAULT 2,

    -- Pricing
    "yurtPrice" REAL,
    "experiencePrice" REAL DEFAULT 0,
    "extrasPrice" REAL DEFAULT 0,
    "totalPrice" REAL,

    -- Booking details
    status TEXT,

    "hasBreakfast" BOOLEAN DEFAULT FALSE,
    "isPaid" BOOLEAN DEFAULT FALSE,

    observations TEXT,

    -- Relationships
    "yurtId" BIGINT REFERENCES public.yurts(id),
    "experienceId" BIGINT REFERENCES public.experiences(id),
    "guestId" BIGINT REFERENCES public.guests(id)
);